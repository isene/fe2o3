# Matrix: green code on black.
# Green letters on black everywhere, katakana down the launcher and on the
# bar, and the code raining on the wallpaper (make it once with
# tools/matrix-wall WIDTH HEIGHT). glass's tint turns every app green in a
# new terminal, pictures too. With the beam-in on in fx, a new window
# arrives as falling code. Red stays red: the red pill.

[views]
notice = Wake up, Neo. The Matrix has you.

[strip]
bg = #000000
segment_fg = #00ff41
palette.32 = #00ff41
palette.33 = #ccff66
palette.34 = #00c832
palette.35 = #b8ffc8
palette.36 = #3fbf7f
palette.37 = #00c832
palette.90 = #1f4d1f
palette.95 = #b8ffc8
palette.96 = #008f11
segment code +8 #00ff41 /bin/echo ﾊﾐﾋｰｳｼﾅﾓﾆ 0

